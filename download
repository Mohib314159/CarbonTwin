import base64, os

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def img(name):
    with open(os.path.join(HERE, "assets", name), "rb") as f:
        return "data:image/png;base64," + base64.b64encode(f.read()).decode()


